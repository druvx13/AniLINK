        epLinks: (document.location.pathname.startsWith(&#39;/title/&#39;)) ? &#39;.item-title a&#39; : &#39;.video-container .clearfix &gt; a&#39;,
        epTitle: &#39;.title &gt; a&#39;,
        epNum: &#39;.watch_curep&#39;,
